[Unit]
Description=SilentDeluge GitHub factory project token refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
LimitCORE=0
EnvironmentFile=/etc/silentdeluge-factory/project-app.env
LoadCredential=github-app.pem:/etc/silentdeluge-factory/github-app.pem
ExecStart=/usr/bin/python3 -I -B /opt/silentdeluge-factory/factory/refresh_project_token.py
RuntimeDirectory=silentdeluge-factory-credentials
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=1min
StandardOutput=null
